export default { version: 1, wgsl: "struct Composite{params:vec4f,}@group(0) @binding(0) var<uniform> composite:Composite;@group(0) @binding(1) var scene:texture_2d<f32>;@group(0) @binding(2) var bloomNear:texture_2d<f32>;@group(0) @binding(3) var bloomMedium:texture_2d<f32>;@group(0) @binding(4) var bloomFar:texture_2d<f32>;@group(0) @binding(5) var linearSampler:sampler;const EXPOSURE:f32=1.15;const SATURATION:f32=0.0;fn aces(a:vec3f)-> vec3f{let b=2.51;let c=0.03;let d=2.43;let e=0.59;let f=0.14;return clamp((a*(b*a+vec3f(c)))/(a*(d*a+vec3f(e))+vec3f(f)),vec3f(0.0),vec3f(1.0));}fn tonemap(a:vec3f,b:vec2f)-> vec3f{var c=aces(a*EXPOSURE);let d=b-vec2f(0.5);let e=1.0-smoothstep(0.55,1.15,length(d)*1.6);c*=mix(0.72,1.0,e);c=pow(c,vec3f(1.0/2.2));let f=dot(c,vec3f(0.2126,0.7152,0.0722));return mix(vec3f(f),c,SATURATION);}@fragment fn fs_main(@location(0) a:vec2f)-> @location(0) vec4f{let b=textureSample(scene,linearSampler,a).rgb;let c=textureSample(bloomNear,linearSampler,a).rgb*0.50+textureSample(bloomMedium,linearSampler,a).rgb*0.32+textureSample(bloomFar,linearSampler,a).rgb*0.18;let d=b+c*composite.params.x;return vec4f(tonemap(d,a),1.0);}" };