export default { version: 1, wgsl: "struct Bloom{sourceSize:vec2f,direction:vec2f,params:vec4f,}@group(0) @binding(0) var<uniform> bloom:Bloom;@group(0) @binding(1) var source:texture_2d<f32>;@group(0) @binding(2) var linearSampler:sampler;fn softThreshold(a:vec3f)-> vec3f{let b=bloom.params.x;if(b<=0.0){return a;}let c=dot(a,vec3f(0.2126,0.7152,0.0722));let d=max(min(bloom.params.y,b),0.000001);let e=clamp(c-b+d,0.0,2.0*d);let f=e*e/(4.0*d+0.0001);let g=max(c-b,f)/max(c,0.0001);return a*g;}fn downsample(a:vec2f)-> vec3f{let b=1.0/bloom.sourceSize;let c=b*0.5;let d=(textureSample(source,linearSampler,a+vec2f(-c.x,-c.y)).rgb+textureSample(source,linearSampler,a+vec2f(c.x,-c.y)).rgb+textureSample(source,linearSampler,a+vec2f(-c.x,c.y)).rgb+textureSample(source,linearSampler,a+vec2f(c.x,c.y)).rgb)*0.25;return softThreshold(d);}fn gaussianBlur(a:vec2f)-> vec3f{let b=max(bloom.params.z,0.5);let c=0.5/(b*b);let d=1.0;let e=exp(-1.0*c);let f=exp(-4.0*c);let g=exp(-9.0*c);let h=exp(-16.0*c);let i=e+f;let j=g+h;let k=(e+2.0*f)/max(i,0.000001);let l=(3.0*g+4.0*h)/max(j,0.000001);let m=d+2.0*(i+j);let n=bloom.direction/bloom.sourceSize;var o=textureSample(source,linearSampler,a).rgb*d;o+=textureSample(source,linearSampler,a+n*k).rgb*i;o+=textureSample(source,linearSampler,a-n*k).rgb*i;o+=textureSample(source,linearSampler,a+n*l).rgb*j;o+=textureSample(source,linearSampler,a-n*l).rgb*j;return o/m;}@fragment fn fs_main(@location(0) a:vec2f)-> @location(0) vec4f{var b:vec3f;if(bloom.params.w>0.5){b=gaussianBlur(a);}else{b=downsample(a);}return vec4f(b,1.0);}" };